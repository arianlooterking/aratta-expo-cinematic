# Optional public canonical URL, fixed at build time. Not a secret.
# Omit to retain the existing ChatGPT Sites canonical URL.
NEXT_PUBLIC_SITE_URL=

# Admin publish backend
#
# The admin panel can edit local drafts and export JSON without these values.
# Production content writes are disabled until these server-side values are set.

# Passkey entered in /admin and sent as x-admin-token to the server route.
ADMIN_WRITE_TOKEN=

# Secure backend, GitHub Action, CMS endpoint, or deploy workflow that persists approved content.
ADMIN_CONTENT_WEBHOOK_URL=

# Optional bearer token sent from the server to ADMIN_CONTENT_WEBHOOK_URL.
ADMIN_CONTENT_WEBHOOK_TOKEN=

# Optional server-side plan reconstruction for staff map imports.
# Files are sent only when an operator explicitly chooses AI reconstruction.
OPENAI_API_KEY=
# Comma-separated staff emails permitted to use the paid reconstruction route.
# Sites supplies the signed-in email through Sign in with ChatGPT.
ARATTA_AI_ALLOWED_EMAILS=
# GPT-5.6 keeps original image detail for dense floor-plan extraction.
OPENAI_PLAN_RECONSTRUCTION_MODEL=gpt-5.6

# Supabase project (Project settings → API). Both are safe in the browser:
# row level security decides what each signed-in staff member can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for the workbook importer on a trusted machine. Never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
